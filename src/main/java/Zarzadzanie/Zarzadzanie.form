            </properties>
          </component>
          <component id="a1f04" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Nazwisko:"/>
            </properties>
          </component>
          <component id="a1f05" class="javax.swing.JTextField" binding="poleNazwisko">
            <constraints/>
            <properties>
              <columns value="10"/>
            </properties>
          </component>
          <component id="a1f06" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Stanowisko:"/>
            </properties>
          </component>
          <component id="a1f07" class="javax.swing.JTextField" binding="poleStanowisko">
            <constraints/>
            <properties>
