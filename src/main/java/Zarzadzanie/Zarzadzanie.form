<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Zarzadzanie.Zarzadzanie">
  <grid id="27dc6" binding="panel1" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="600" height="450"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a1f01" binding="panelFormularza" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a1f02" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Imię:"/>
            </properties>
          </component>
          <component id="a1f03" class="javax.swing.JTextField" binding="poleImie">
            <constraints/>
            <properties>
